{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dccms-family-connect-production",
			"database_id": "67886a8c-7cce-43a2-8cf2-38683e6836b8",
			"migrations_dir": "migrations"
		}
	]
}